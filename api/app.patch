+def update_paciente(id):
+    paciente = Paciente.query.get_or_404(id)
+    dados = request.get_json()
+    
+    if 'idade' in dados: paciente.idade = dados['idade']
+    if 'telefone' in dados: paciente.telefone = dados['telefone']
